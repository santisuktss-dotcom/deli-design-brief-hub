# Copy to supabase/.env (git-ignored) and fill in. Read by `npx supabase start` for config.toml's env(...) values.
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-client-secret
