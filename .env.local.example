# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The one Google account allowed to sign in as Design Manager (full access).
MANAGER_EMAIL=manager@example.com

# Email notifications (app/api/notify-email) — set these in Netlify's own env var UI,
# never commit real values here.
# From resend.com/api-keys after creating a free account.
RESEND_API_KEY=re_your_api_key
# From Supabase dashboard: Project Settings > API > service_role key. Bypasses RLS —
# keep this server-side only, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any random string you choose — must match the header Supabase's Database Webhook sends.
NOTIFY_WEBHOOK_SECRET=choose-a-random-secret
# The site's real public URL, used to build the link inside notification emails.
NEXT_PUBLIC_SITE_URL=https://delidesign.online
